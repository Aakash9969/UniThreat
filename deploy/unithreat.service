[Unit]
Description=UniThreat — AI threat detection for unidirectional IP traffic
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# adjust User and paths to your deployment
User=unithreat
Group=unithreat
WorkingDirectory=/opt/unithreat
ExecStart=/opt/unithreat/.venv/bin/python scripts/run_server.py --host 0.0.0.0
Restart=on-failure
RestartSec=5
# live capture needs CAP_NET_RAW
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/unithreat/data /opt/unithreat/models

[Install]
WantedBy=multi-user.target
